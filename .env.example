# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# ---------------------------------------------------------------------------
# DB chính hệ thống (label: he-thong) — reports, kho, lệnh SX, hàng hỏng, ...
# ---------------------------------------------------------------------------
# SUPABASE_MAIN_DB_LABEL="he-thong"
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   (service_role, không phải anon key)
#
# ---------------------------------------------------------------------------
# DB phiếu cân riêng (label: phieu-can) — chỉ /api/phieu-can-dinh-ki
# ---------------------------------------------------------------------------
# SUPABASE_WEIGHING_DB_LABEL="phieu-can"
# SUPABASE_WEIGHING_URL=https://yyy.supabase.co
# SUPABASE_WEIGHING_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_WEIGHING_KEY=eyJ...anon...
# SUPABASE_WEIGHING_SERVICE_KEY=eyJ...service_role...
# SUPABASE_CAN_TU_DONG_TABLE=can_tu_dong
# SUPABASE_CAN_TU_DONG_STORAGE_BUCKET=roll-captures
#
# ---------------------------------------------------------------------------
# DB kiểm kho riêng — chỉ /api/kiem-kho*
# ---------------------------------------------------------------------------
# SUPABASE_KIEM_KHO_DB_LABEL="kiem-kho"
# SUPABASE_KIEM_KHO_URL=https://zzz.supabase.co
# SUPABASE_KIEM_KHO_KEY=eyJ...anon...
# SUPABASE_KIEM_KHO_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_KIEM_KHO_SERVICE_KEY=sb_secret_...
# SUPABASE_KIEM_KHO_TABLE=kiem_kho
# SUPABASE_KIEM_KHO_TONG_HOP_TABLE=kiem_kho_tong_hop
#
# Sau khi thêm biến, bấm Redeploy. Kiểm tra: https://your-app.vercel.app/api/health

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.

SUPABASE_WEIGHING_TABLE="phieu_can_dinh_ki"
SUPABASE_TABLE="reports"
SUPABASE_PRODUCTS_TABLE="san_pham"
SUPABASE_ORDERS_TABLE="don_hang"
SUPABASE_CUSTOMERS_TABLE="khach_hang"
SUPABASE_SETTINGS_TABLE="cai_dat_thoi_gian"
SUPABASE_PRODUCTION_ORDERS_TABLE="lenh_sx"
SUPABASE_PRODUCTION_PLANS_TABLE="ke_hoach_san_xuat"
SUPABASE_PRODUCTION_PLAN_LINES_TABLE="ke_hoach_san_xuat_dong"
SUPABASE_MATERIALS_TABLE="kho_nvl"
SUPABASE_MACHINES_TABLE="danh_sach_may"
SUPABASE_WAREHOUSE_MOVEMENTS_TABLE="phieu_xuat_nhap_kho"
# Optional: database password for auto-migration (Project Settings → Database)
# SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_MIXING_REPORTS_TABLE="bao_cao_phoi_tron"
SUPABASE_ACCEPTANCE_REPORTS_TABLE="bao_cao_nghiem_thu"
SUPABASE_MACHINE_DOWNTIME_TABLE="phieu_bao_dung_may"
SUPABASE_STAFF_TABLE="nhan_su"
SUPABASE_STAFF_DEPARTMENT="Sản xuất"
SUPABASE_STAFF_BRANCH="Đà Nẵng"

# Address Engine API. Khi chạy local, khởi động adress_engine tại cổng 8000.
ADDRESS_ENGINE_URL="http://127.0.0.1:8000"

# Vietmap: Services Key dùng cho Search/Place/Route/Matrix; Tile Key dùng hiển thị bản đồ.
VIETMAP_SERVICES_KEY=""
VIETMAP_TILE_KEY=""

# Cloudinary: used for uploading weighing report images.
